# 本地开发环境模板。启动脚本会在 apps/backend/.env 不存在时复制本文件。

LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano-2025-08-07
LLM_API_KEY=
# LLM_API_BASE=http://localhost:11434
# 结构化生成、Agent 与导入流程共用的默认输出预算。
LLM_MAX_TOKENS=32768

HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO
LOG_LLM=WARNING
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
REQUEST_TIMEOUT_SECONDS=240

# 简历生成：Qdrant dense + sparse + RRF 召回。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_evidence
QDRANT_DENSE_MODEL=BAAI/bge-small-zh-v1.5
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_TIMEOUT_SECONDS=20

# Memory 和简历索引 Worker 共用的后台任务设施。
REDIS_URL=redis://127.0.0.1:6379/0
BACKGROUND_OUTBOX_POLL_SECONDS=0.5
BACKGROUND_OUTBOX_PUBLISH_LEASE_SECONDS=60
BACKGROUND_OUTBOX_BATCH_SIZE=100

# JD URL 导入依赖独立的 Playwright MCP 服务。
PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931/mcp
# 仅当浏览器只能经由下方受限出口代理访问公网时才开启。
PLAYWRIGHT_MCP_EGRESS_SECURED=true
PLAYWRIGHT_MCP_TIMEOUT_SECONDS=45
