{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: FastAPI (Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/apps/backend",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "RELOAD": "false"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
